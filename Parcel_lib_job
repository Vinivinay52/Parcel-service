@Library('pipeline_library') _

pipeline {
    agent { label 'java' }

    tools {
        jdk 'JDK17'
        maven 'maven'
    }

    stages {

        stage('Library-Demo') {
            steps {
                echo 'Executing a shared lib function'
                sayHello 'Devops'
            }
        }

        stage('Checkout') {
            steps {
                script {
                    sh """
                        rm -rf Parcel-service
                        git clone -b main https://github.com/Vinivinay52/Parcel-service.git

                        ls -ltr
                    """
                }
            }
        }

        stage('Build') {
            steps {
                dir('Parcel-service') {
                    sh 'mvn clean install'
                }
            }
        }
    }
}
